{
  "name": "turnero-totem",
  "version": "1.1.3",
  "description": "Aplicación de escritorio para totems del sistema Turnero",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder",
    "build:win": "electron-builder --win --x64",
    "pack": "electron-builder --dir",
    "test-print": "node test-print-local.js"
  },
  "author": "Dayco Gaming S.A.",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.1.0",
    "electron-builder": "^24.9.1"
  },
  "dependencies": {
    "dotenv": "^16.3.1",
    "electron-store": "^8.1.0",
    "pdf-to-printer": "^5.6.0"
  },
  "build": {
    "appId": "com.daycogaming.turnero.totem",
    "productName": "Turnero Totem",
    "directories": {
      "output": "dist"
    },
    "extraResources": [
      {
        "from": "print_ticket.py",
        "to": "print_ticket.py"
      },
      {
        "from": "env.example",
        "to": "env.example"
      }
    ],
    "win": {
      "certificateFile": "C:/Users/Usuario/Desktop/Turnero/turnero-totem/turnero-cert.pfx",
      "certificatePassword": "1234",
      "signingHashAlgorithms": ["sha256"],
      "timeStampServer": null,
      "target": [
    {
      "target": "nsis",
      "arch": ["x64"]
    },
    {
      "target": "portable",
      "arch": ["x64"]
    },
    {
      "target": "appx",
      "arch": ["x64"]
    }
    ],
    "icon": "assets/icon.ico"
    },
    "appx": {
      "identityName": "com.daycogaming.turnero.totem",
      "publisher": "CN=DaycoGaming",
      "publisherDisplayName": "Dayco Gaming S.A.",
      "applicationId": "TurneroTotem"
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true
    },
    "files": [
      "**/*",
      "!**/node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!**/node_modules/*/{test,__tests__,tests,powered-test,example,examples}",
      "!**/node_modules/.bin"
    ]
  }
}

