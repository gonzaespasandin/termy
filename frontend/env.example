# URL del servicio de impresión local
# Por defecto: http://localhost:5000
# Si cambiaste el host/puerto en print_service/.env, actualiza aquí también
VITE_PRINT_SERVICE_URL=http://localhost:5000

# URL de la API de Laravel
# Produccion (mismo dominio que el front, nginx hace proxy): /api
# Desarrollo en LAN: http://<ip-del-backend>:8000/api
VITE_API_URL=/api

