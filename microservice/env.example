# ============================================================
# CONFIGURACIÓN DEL TOTEM
# Copiar este archivo a .env y configurar los valores
# ============================================================

# URL del servidor (Vue frontend)
# Cambiar a la IP de tu servidor
SERVER_URL=http://192.168.0.51:5173

# Código único de este totem (debe coincidir con la BD)
TOTEM_CODE=TOTEM-PRINCIPAL

# Nombre de la empresa (aparece en los tickets)
COMPANY_NAME=Dayco Gaming S.A.

# Nombre de la impresora (dejar vacío para usar la predeterminada)
# Ejemplo: PRINTER_NAME=KPOS_58 Printer
PRINTER_NAME=

# Ancho del ticket en mm (típico: 58 o 80)
TICKET_WIDTH=58

# Auto-iniciar con Windows (true/false)
AUTO_START=true

# ============================================================
# PYTHON (solo si "python" no está disponible en PATH)
# ============================================================
# Si instalaste Python desde Microsoft Store o tu entorno no tiene "python" en PATH,
# podés indicar el ejecutable a usar.
#
# Ejemplos:
# PYTHON_EXE=python
# PYTHON_EXE=C:\Python312\python.exe
PYTHON_EXE=python

# ============================================================
# MODO KIOSKO - MANTENIMIENTO
# ============================================================
# Hash SHA-256 de la contraseña para salir del modo kiosko.
# Atajo: Ctrl+Alt+Shift+Q (abre un prompt de contraseña).
# Generar el hash con:
#   node -e "console.log(require('crypto').createHash('sha256').update('TU_CONTRASEÑA').digest('hex'))"
# Dejar vacío deshabilita el atajo de mantenimiento.
KIOSK_EXIT_PASSWORD_HASH=

