# Production environment template for the Termy backend.
# Copy to /var/www/termy/backend/.env on the server and fill in the values.
# Never commit the real file.

APP_NAME=Termy
APP_ENV=production
APP_DEBUG=false
# Generate with: php artisan key:generate
APP_KEY=
APP_URL=https://turnos.example.com
# The application timezone is fixed in config/app.php (America/Argentina/Buenos_Aires).

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

FRONTEND_URL=https://turnos.example.com

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=termy
DB_USERNAME=termy
DB_PASSWORD=CHANGE_ME

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
QUEUE_CONNECTION=redis
